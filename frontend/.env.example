# API del backend
VITE_API_URL=http://localhost:8000
# Voz: true reproduce los audios de public/audio/ (si existen). La demo funciona sin ellos.
VITE_ENABLE_VOICE=true
# Solo para generar los audios (npm run gen:voice). NUNCA subir la clave al repo.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2
