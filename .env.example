# Copiad este archivo a .env (no se sube). make run-api lo carga. En Render, las mismas variables en Environment.
# Vega con Claude (sin ella, preguntas frecuentes fijas)
ANTHROPIC_API_KEY=
# Voz de Vega desde el servidor: la MISMA voz que se usó para los audios de frontend/public/audio
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Base de datos PostgreSQL donde se guardan las partidas (en producción, obligatoria)
DATABASE_URL=
# Dirección pública del frontend al desplegar (separadas por comas)
BEHAVIORLAB_CORS_ORIGINS=
# Tiempo por decisión en ms (por defecto 30000)
BEHAVIORLAB_DECISION_TIMEOUT_MS=
LLM_BUDGET_EUR=100
ENABLE_VOICE=false
